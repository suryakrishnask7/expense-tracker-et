# Expense Tracker ET - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# Flask Application Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# Server Settings
HOST=127.0.0.1
PORT=5000

# Database Configuration
# Relative path from project root (e.g. instance/expense_tracker.db)
# or absolute path on production Linux (e.g. /var/lib/expense-tracker-et/expense_tracker.db)
DATABASE_PATH=instance/expense_tracker.db

# Application Preferences Defaults
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_CURRENCY_CODE=INR
DEFAULT_DATE_FORMAT=%Y-%m-%d
DEFAULT_MONTHLY_BUDGET=50000.00
